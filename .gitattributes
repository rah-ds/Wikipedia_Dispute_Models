# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.ipynb text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pkl binary
*.h5 binary
*.hdf5 binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
