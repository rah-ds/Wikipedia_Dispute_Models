      <bpmn:outgoing>Flow_88e83ab4</bpmn:outgoing>
      <bpmn:outgoing>Flow_b0380cbf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endEve_f9234440" name="★ Strong consensus to SUPPORT — implement">
      <bpmn:documentation>The discussion concluded with broad support for granting local administrators the ability to view global abuse filters and the abuse logs, as well as formalizing a process for requesting abuse filter editor rights. Stewards' editing rights were affirmed.</bpmn:documentation>
      <bpmn:incoming>Flow_7041cc0e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEve_8532d87d" name="Rough consensus to support — implement with caveats">
      <bpmn:documentation>Possible outcome — not the one reached.</bpmn:documentation>
      <bpmn:incoming>Flow_019d3069</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEve_7d3a9e1d" name="No consensus — status quo / no change">
      <bpmn:documentation>Possible outcome — not the one reached.</bpmn:documentation>
      <bpmn:incoming>Flow_dd88cf77</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEve_d13a10ab" name="Rough consensus to OPPOSE — do not implement">
