    <bpmn:startEvent id="startE_556f367e" name="Content Dispute Identified">
      <bpmn:documentation>The editor is disputing the romanization of the article's name between &quot;Touhou&quot; and &quot;Tōhō&quot;, arguing that &quot;Tōhō&quot; is more appropriate according to Wikipedia's romanization guidelines, despite the widespread use of &quot;Touhou&quot; within the fandom.</bpmn:documentation>
      <bpmn:outgoing>Flow_71423949</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="userTa_012c2eb5" name="File DRN: Mr. Stradivarius re: Touhou_Project">
      <bpmn:documentation>The editor is disputing the romanization of the article's name between &quot;Touhou&quot; and &quot;Tōhō&quot;, arguing that &quot;Tōhō&quot; is more appropriate according to Wikipedia's romanization guidelines, despite the widespread use of &quot;Touhou&quot; within the fandom.</bpmn:documentation>
